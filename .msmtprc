# msmtp talks to emailproxy on localhost.  emailproxy handles the
# provider-side TLS and OAuth authentication.

defaults
# The proxy deliberately exposes plaintext localhost SMTP.  Select PLAIN
# explicitly; msmtp's automatic auth selection rejects cleartext methods when
# TLS is disabled.
auth plain
tls off

account gmail
host 127.0.0.1
port 2465
from timfelgentreff@gmail.com
user timfelgentreff@gmail.com
passwordeval secret-tool lookup service emailproxy account timfelgentreff@gmail.com

account outlook
host 127.0.0.1
port 1587
from tim.felgentreff@oracle.com
user tim.felgentreff@oracle.com
passwordeval secret-tool lookup service emailproxy account tim.felgentreff@oracle.com

account default : gmail
