#!/bin/bash

this="$(dirname "${BASH_SOURCE[0]}")"

NEWPATH=":${PATH}:"
NEWPATH="${NEWPATH//:${this}:/:}"
NEWPATH="${NEWPATH#:}"   # remove leading colon
NEWPATH="${NEWPATH%:}"   # remove trailing colon
export PATH="$NEWPATH"

if which firefox 2>/dev/null >/dev/null; then
    exec firefox "$@"
elif which flatpak-spawn 2>/dev/null >/dev/null; then
    if flatpak-spawn --host which flatpak 2>/dev/null >/dev/null; then
        if flatpak-spawn --host flatpak info org.mozilla.firefox 2>/dev/null >/dev/null; then
            # just ensure we have webcam/mic rn
            flatpak-spawn --host flatpak override --user --device=all org.mozilla.firefox
            exec flatpak-spawn --host flatpak run org.mozilla.firefox "$@"
        fi
    fi

    if ( flatpak-spawn --host which firefox 2>/dev/null >/dev/null ); then
        exec flatpak-spawn --host firefox "$@"
    fi
fi

# fallback to error out
exec firefox "$@"
