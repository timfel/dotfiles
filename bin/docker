#!/bin/bash

this="$(dirname "${BASH_SOURCE[0]}")"

NEWPATH=":${PATH}:"
NEWPATH="${NEWPATH//:${this}:/:}"
NEWPATH="${NEWPATH#:}"
NEWPATH="${NEWPATH%:}"
export PATH="$NEWPATH"

if which flatpak-spawn 2>/dev/null >/dev/null; then
    if flatpak-spawn --host which docker 2>/dev/null >/dev/null; then
        exec flatpak-spawn --host docker "$@"
    fi

    if flatpak-spawn --host which podman 2>/dev/null >/dev/null; then
        exec flatpak-spawn --host podman "$@"
    fi
fi

if which docker 2>/dev/null >/dev/null; then
    exec docker "$@"
elif which podman 2>/dev/null >/dev/null; then
    exec podman "$@"
fi

exec docker "$@"
